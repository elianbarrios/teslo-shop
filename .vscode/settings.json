{
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "angular-schematics.schematicsDefaultOptions": {
    "angular-component": {
      "skipChangeDetectionOnPush": true
    },
    "angular-*": {
      "skipStyle": true,
      "externalTemplate": true
    },
    "angular-page": {
      "skipChangeDetectionOnPush": true
    }
  },
  "angular.enable-strict-mode-prompt": false
}
